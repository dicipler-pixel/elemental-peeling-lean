/-
The exact interface between DiracTime.PathLedger and DiracTime.PhaseSilence.
This file imports the repository modules themselves. The build command records
where their prebuilt oleans live; no statement from a paper is assumed.
-/
import DiracTime.PathLedger
import DiracTime.PhaseSilence

namespace Interface

/-- Integer words on a single vertex. Composition and reversal below make these
words the loops generated by one phase offset. -/
abbrev LoopWord (_ _ : Unit) : Type := ℤ

def loopComp {x y z : Unit} (a : LoopWord x y) (b : LoopWord y z) : LoopWord x z :=
  a + b

def loopRev {x y : Unit} (a : LoopWord x y) : LoopWord y x :=
  -a

/-- The cyclic phase ledger: the integer word `k` has ledger `k [r]` in `ℝ ⧸ ℤ`. -/
def loopLedger (r : ℝ) {x y : Unit} (a : LoopWord x y) : AddCircle (1 : ℝ) :=
  a • (r : AddCircle (1 : ℝ))

/-- THEOREM. Vanishing modulo one is exactly the repository's sector-silence
criterion. In particular, the integer on the right of `silent_sector_iff` is
not an accidental arithmetic artefact: it is the period of the phase ledger. -/
theorem silent_sector_iff_mod_one (p q a : ℤ) (εm εl : ℝ) :
    (((p * q : ℝ) * εm + εl + a / 2 : ℝ) : AddCircle (1 : ℝ)) = 0 ↔
      ∃ m n : ℤ, (m + εm) * (-(p * q : ℝ)) - 1 * (n + εl + a / 2) = 0 := by
  rw [DiracTime.PhaseSilence.silent_sector_iff]
  constructor
  · intro h
    obtain ⟨k, hk⟩ := (AddCircle.coe_eq_zero_iff (1 : ℝ)).mp h
    exact ⟨k, by simpa using hk.symm⟩
  · rintro ⟨k, hk⟩
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr
    exact ⟨k, by simpa using hk.symm⟩

/-- THEOREM. `PathLedger.descent_iff`, applied literally to the cyclic phase
ledger, is equivalent to `PhaseSilence.silent_sector_iff`. -/
theorem cyclic_descent_iff_silent_sector (p q a : ℤ) (εm εl : ℝ) :
    (∃ potential : Unit → AddCircle (1 : ℝ),
        ∀ {x y : Unit} (w : LoopWord x y),
          loopLedger ((p * q : ℝ) * εm + εl + a / 2) w = potential y - potential x) ↔
      ∃ m n : ℤ, (m + εm) * (-(p * q : ℝ)) - 1 * (n + εl + a / 2) = 0 := by
  have hcomp : ∀ {x y z : Unit} (u : LoopWord x y) (v : LoopWord y z),
      loopLedger ((p * q : ℝ) * εm + εl + a / 2) (loopComp u v) =
        loopLedger ((p * q : ℝ) * εm + εl + a / 2) u +
          loopLedger ((p * q : ℝ) * εm + εl + a / 2) v := by
    intros x y z u v
    change (u + v) • (((p * q : ℝ) * εm + εl + a / 2 : ℝ) : AddCircle (1 : ℝ)) =
      u • (((p * q : ℝ) * εm + εl + a / 2 : ℝ) : AddCircle (1 : ℝ)) +
        v • (((p * q : ℝ) * εm + εl + a / 2 : ℝ) : AddCircle (1 : ℝ))
    exact add_zsmul _ u v
  have hrev : ∀ {x y : Unit} (u : LoopWord x y),
      loopLedger ((p * q : ℝ) * εm + εl + a / 2) (loopRev u) =
        -loopLedger ((p * q : ℝ) * εm + εl + a / 2) u := by
    intros x y u
    change (-u) • (((p * q : ℝ) * εm + εl + a / 2 : ℝ) : AddCircle (1 : ℝ)) =
      -(u • (((p * q : ℝ) * εm + εl + a / 2 : ℝ) : AddCircle (1 : ℝ)))
    exact neg_zsmul _ u
  have hd := DiracTime.PathLedger.descent_iff (X := Unit) (P := LoopWord)
    loopComp loopRev (loopLedger ((p * q : ℝ) * εm + εl + a / 2))
    hcomp hrev (fun (_ _ : Unit) => ⟨0⟩)
  rw [hd]
  constructor
  · intro h
    apply (silent_sector_iff_mod_one p q a εm εl).mp
    have h1 := h (x := ()) (1 : LoopWord () ())
    simpa [loopLedger] using h1
  · intro h
    have hr := (silent_sector_iff_mod_one p q a εm εl).mpr h
    intro x u
    simp [loopLedger, hr]

/-- REFUTED (real-valued identification). At `p=q=1`, `a=0`, `εm=1`, `εl=0`,
a silent sector exists although the unquotiented real offset is `1`, not `0`.
Thus replacing `AddCircle 1` above by `ℝ` changes the theorem and is false. -/
theorem real_offset_zero_not_necessary :
    (∃ m n : ℤ,
      (m + (1 : ℝ)) * (-(((1 : ℤ) * (1 : ℤ) : ℤ) : ℝ)) -
        1 * (n + (0 : ℝ) + (0 : ℤ) / 2) = 0) ∧
      (((1 : ℤ) * (1 : ℤ) : ℝ) * (1 : ℝ) + (0 : ℝ) + (0 : ℤ) / 2 ≠ 0) := by
  constructor
  · refine ⟨0, -1, ?_⟩
    norm_num
  · norm_num

end Interface
