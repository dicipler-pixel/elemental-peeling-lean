/-
Chiral pairing and odd spectral moments (§5 of "The Dirac Time of the Gigantefermion",
Jeromie Beasley, DOI 10.5281/zenodo.22978630).

The manuscript's §5 claim is about *signed spectral flow* and *the eta invariant*. Neither is
constructed here, and nothing below mentions them. What is proved is the finite-dimensional core:
if an invertible `S` conjugates `T` to `-T`, the spectrum is exactly paired under `μ ↦ -μ` and
every odd spectral moment vanishes. That is what makes the negative control work — a scalar ledger
with chirality has no sign to carry — but it is not the analytical statement, and LIMITATIONS.md
records the difference.

The last section is a concrete two-dimensional pair, so the general theorems are met by an
instance computed directly rather than only through their own proof.
-/
import Mathlib

namespace DiracTime.ChiralPairing

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

/-- Conjugation by `S` is multiplicative on the algebra generated by `T`. -/
theorem conj_pow (S : V ≃ₗ[K] V) (T : V →ₗ[K] V) (n : ℕ) :
    S.conj (T ^ n) = (S.conj T) ^ n := by
  induction n with
  | zero => ext x; simp
  | succ n ih =>
    have hstep : T ^ (n + 1) = (T ^ n).comp T := by rw [pow_succ]; rfl
    rw [hstep, LinearEquiv.conj_comp, ih, pow_succ]
    rfl

/-- §5: a chiral symmetry sends every power of `T` to the corresponding power of `-T`. -/
theorem conj_pow_chiral (S : V ≃ₗ[K] V) (T : V →ₗ[K] V) (h : S.conj T = -T) (n : ℕ) :
    S.conj (T ^ n) = (-T) ^ n := by
  rw [conj_pow, h]

/-- §5: exact pairing of the scalar spectrum. A `μ`-eigenvector is sent to a `(-μ)`-eigenvector. -/
theorem hasEigenvector_neg (S : V ≃ₗ[K] V) (T : V →ₗ[K] V) (h : S.conj T = -T)
    {μ : K} {x : V} (hx : Module.End.HasEigenvector T μ x) :
    Module.End.HasEigenvector T (-μ) (S x) := by
  have hT : T = -(S.conj T) := by rw [h]; simp
  have hconj_apply : (S.conj T) (S x) = μ • S x := by
    rw [LinearEquiv.conj_apply_apply, LinearEquiv.symm_apply_apply, hx.apply_eq_smul, map_smul]
  have hTx : T (S x) = -μ • S x := by
    have h1 : T (S x) = -((S.conj T) (S x)) := by
      simpa using congrArg (fun g : V →ₗ[K] V => g (S x)) hT
    rw [h1, hconj_apply, neg_smul]
  exact Module.End.hasEigenvector_iff.2
    ⟨Module.End.mem_eigenspace_iff.2 hTx, by simpa using hx.2⟩

/-- §5: the eigenvalue set is invariant under `μ ↦ -μ`. -/
theorem hasEigenvalue_neg_iff (S : V ≃ₗ[K] V) (T : V →ₗ[K] V) (h : S.conj T = -T)
    (μ : K) : Module.End.HasEigenvalue T μ ↔ Module.End.HasEigenvalue T (-μ) := by
  constructor
  · intro hμ
    obtain ⟨x, hx⟩ := hμ.exists_hasEigenvector
    exact Module.End.hasEigenvalue_of_hasEigenvector (hasEigenvector_neg S T h hx)
  · intro hμ
    obtain ⟨x, hx⟩ := hμ.exists_hasEigenvector
    have hx' : Module.End.HasEigenvector T (-(-μ)) (S x) := hasEigenvector_neg S T h hx
    rw [neg_neg] at hx'
    exact Module.End.hasEigenvalue_of_hasEigenvector hx'

/-- §5, finite-dimensional core: every odd spectral moment vanishes under a chiral symmetry.

`[Module.Finite K V]` is carried for meaning rather than for the proof: `LinearMap.trace` is `0`
by definition on a module that admits no basis, so without it the statement would be partly
vacuous. Over a field `Module.Free` is automatic, so no such hypothesis is needed — the `example`
below is the machine read of that. -/
theorem trace_pow_eq_zero_of_odd [CharZero K] [Module.Finite K V] (S : V ≃ₗ[K] V)
    (T : V →ₗ[K] V) (h : S.conj T = -T) {n : ℕ} (hn : Odd n) :
    LinearMap.trace K V (T ^ n) = 0 := by
  have hconj : LinearMap.trace K V (S.conj (T ^ n)) = LinearMap.trace K V (T ^ n) :=
    LinearMap.trace_conj' (T ^ n) S
  rw [conj_pow_chiral S T h n, hn.neg_pow, map_neg] at hconj
  have hzero : LinearMap.trace K V (T ^ n) + LinearMap.trace K V (T ^ n) = 0 := by
    nth_rewrite 1 [← hconj]
    simp
  have htwo : (2 : K) • LinearMap.trace K V (T ^ n) = 0 := by
    rw [two_smul]
    exact hzero
  rcases smul_eq_zero.mp htwo with h2 | h2
  · exact absurd h2 (by norm_num)
  · exact h2

/-- The same statement in the paper's numbering: `tr (T ^ (2k+1)) = 0` for every natural `k`. -/
theorem paper_5_odd_moments [CharZero K] [Module.Finite K V] (S : V ≃ₗ[K] V) (T : V →ₗ[K] V)
    (h : S.conj T = -T) (k : ℕ) :
    LinearMap.trace K V (T ^ (2 * k + 1)) = 0 :=
  trace_pow_eq_zero_of_odd S T h ⟨k, rfl⟩

/-- `Module.Free` is not a hypothesis here because over a field it is automatic. -/
example : Module.Free K V := inferInstance

/-! ### A concrete pair in dimension two

`T2` is a quarter turn and `S2 = diag (1, -1)` conjugates it to `-T2`; `U2` is an upper triangular
matrix with the same shape and no chiral symmetry. The traces below are computed from the entries,
not through the theorems above. -/

/-- The quarter-turn matrix. -/
def T2 : Matrix (Fin 2) (Fin 2) ℚ := !![0, 1; -1, 0]

/-- The chiral grading `diag (1, -1)`. -/
def S2 : Matrix (Fin 2) (Fin 2) ℚ := !![1, 0; 0, -1]

/-- A matrix with no chiral symmetry. -/
def U2 : Matrix (Fin 2) (Fin 2) ℚ := !![0, 1; 0, 1]

/-- The chirality relation, in the form `S T = -T S` that an invertible `S` satisfies. -/
theorem T2_chiral : S2 * T2 = -(T2 * S2) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [S2, T2, Matrix.mul_apply, Fin.sum_univ_two]

/-- The first odd moment vanishes, computed from the entries. -/
theorem T2_trace_zero : T2.trace = 0 := by
  simp [T2, Matrix.trace, Fin.sum_univ_two]

/-- `T2 ^ 2 = -1`, so `T2 ^ 3 = -T2` and the third odd moment vanishes. -/
theorem T2_sq : T2 * T2 = -1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [T2, Matrix.mul_apply, Fin.sum_univ_two]

/-- The third odd moment vanishes, computed from the entries. -/
theorem T2_cubed_trace_zero : (T2 ^ 3).trace = 0 := by
  have h3 : T2 ^ 3 = -T2 := by
    rw [pow_succ, pow_two, T2_sq, neg_mul, one_mul]
  rw [h3, Matrix.trace_neg, T2_trace_zero, neg_zero]

/-- Without chirality an odd trace need not vanish, so the hypothesis does work. -/
theorem U2_trace_one : U2.trace = 1 := by
  simp [U2, Matrix.trace, Fin.sum_univ_two]

end DiracTime.ChiralPairing
