import Mathlib
import LoopWall.PeelPotential

/-!
Direction B8 of the fifth round (swarm `smws70oju`, member m3). The wall gets a clock, and the
clock is unique: `Γ = tanh (ωτ/2)` is strictly increasing for `ω > 0`, so it crosses `Γ² = 1/2`
exactly once in forward time, at `τ = 2 log (1+√2)/ω`, where the peel rate is exactly `ω/4` and the
ledger is exactly `½ log 2`. It also refutes the shorter clock `(1/ω) log (1+√2)` that I wrote in
the round's task statement; the two differ by a factor of two and `short_wall_clock_is_false` says so.

Written in the fifth parallel formalization round and recompiled here before acceptance;
imports hoisted, namespace prefixed to `ElementalPeeling.LoopWall`, nothing else changed.
-/

/-!
# A clock for the peel wall under uniform log-ratio phase

The uniform phase is `t τ = ω τ`, so its reflection is
`peelFlow ω c τ = tanh (ω * τ / 2 + c)`.  We use the library's `wall` and
`φled`, rather than introducing parallel versions.

On the forward branch started at `Γ = 0`, the wall is crossed exactly once,
at `wallTime ω = 2 * artanh wall / ω`, with peel rate `ω / 4`.  Since
`artanh wall = log (1 + sqrt 2)`, this time is
`2 * log (1 + sqrt 2) / ω`.  The shorter expression `log (1 + sqrt 2) / ω`
is explicitly refuted below: it is off by a factor of two.
-/

set_option maxHeartbeats 1000000

namespace ElementalPeeling.LoopWall.WallClock

open ElementalPeeling.LoopWall.PeelPotential

noncomputable section

/-- This Mathlib snapshot has the hyperbolic sine/cosine derivatives but not a
named tangent derivative, so we derive it directly from their quotient rule. -/
theorem hasDerivAt_tanh (x : ℝ) :
    HasDerivAt Real.tanh (1 - Real.tanh x ^ 2) x := by
  have hc : Real.cosh x ≠ 0 := ne_of_gt (Real.cosh_pos x)
  have h := (Real.hasDerivAt_sinh x).div (Real.hasDerivAt_cosh x) hc
  convert h using 1
  · ext y
    exact Real.tanh_eq_sinh_div_cosh y
  · rw [Real.tanh_eq_sinh_div_cosh]
    field_simp [hc]

/-- The closed-form reflection generated by uniform log-ratio phase, with an
arbitrary initial phase offset `c`. -/
def peelFlow (ω c τ : ℝ) : ℝ := Real.tanh (ω * τ / 2 + c)

/-- The uniform-phase reflection obeys exactly the peel equation
`Γ' = (ω / 2) * (1 - Γ²)`. -/
theorem hasDerivAt_peelFlow (ω c τ : ℝ) :
    HasDerivAt (peelFlow ω c)
      ((ω / 2) * (1 - peelFlow ω c τ ^ 2)) τ := by
  have hu : HasDerivAt (fun u : ℝ => ω * u / 2 + c) (ω / 2) τ := by
    convert (((hasDerivAt_id τ).const_mul ω).div_const 2).add_const c using 1
    all_goals first | (ext u; rfl) | ring
  have h := (hasDerivAt_tanh (ω * τ / 2 + c)).comp τ hu
  change HasDerivAt (fun u : ℝ => Real.tanh (ω * u / 2 + c))
    ((ω / 2) * (1 - Real.tanh (ω * τ / 2 + c) ^ 2)) τ
  convert h using 1
  all_goals first | (ext u; rfl) | ring

/-- Derivative form of the peel equation. -/
theorem deriv_peelFlow (ω c τ : ℝ) :
    deriv (peelFlow ω c) τ = (ω / 2) * (1 - peelFlow ω c τ ^ 2) :=
  (hasDerivAt_peelFlow ω c τ).deriv

/-- Positive frequency makes the reflection strictly increasing in time. -/
theorem strictMono_peelFlow {ω : ℝ} (hω : 0 < ω) (c : ℝ) :
    StrictMono (peelFlow ω c) := by
  apply strictMono_of_deriv_pos
  intro τ
  rw [deriv_peelFlow]
  have hs : 0 < 1 - peelFlow ω c τ ^ 2 := by
    exact sub_pos.mpr (Real.tanh_sq_lt_one _)
  positivity

@[simp] theorem peelFlow_zero (ω : ℝ) : peelFlow ω 0 0 = 0 := by
  simp [peelFlow]

/-- Hyperbolic tangent has the sign of its argument; only nonnegativity is
needed for the forward wall branch. -/
theorem tanh_nonneg_of_nonneg {x : ℝ} (hx : 0 ≤ x) : 0 ≤ Real.tanh x := by
  rw [Real.tanh_eq_sinh_div_cosh]
  exact div_nonneg (Real.sinh_nonneg_iff.mpr hx) (Real.cosh_pos x).le

theorem peelFlow_nonneg {ω τ : ℝ} (hω : 0 < ω) (hτ : 0 ≤ τ) :
    0 ≤ peelFlow ω 0 τ := by
  apply tanh_nonneg_of_nonneg
  simp only [add_zero]
  positivity

/-- The unique positive square root defining the wall is strictly positive. -/
theorem wall_pos : 0 < wall := by
  rw [wall]
  positivity

theorem wall_mem_Ioo : wall ∈ Set.Ioo (-1 : ℝ) 1 := by
  have h := abs_wall_lt_one
  rw [abs_lt] at h
  exact h

/-- The wall time measured from zero reflection at time zero. -/
def wallTime (ω : ℝ) : ℝ := 2 * Real.artanh wall / ω

/-- Inverting the closed-form flow: every target in `(-1,1)` is reached once,
and the reaching time is given by `artanh`. -/
theorem peelFlow_eq_iff {ω a : ℝ} (hω : 0 < ω)
    (ha : a ∈ Set.Ioo (-1 : ℝ) 1) (τ : ℝ) :
    peelFlow ω 0 τ = a ↔ τ = 2 * Real.artanh a / ω := by
  have hω0 : ω ≠ 0 := ne_of_gt hω
  simp only [peelFlow, add_zero]
  constructor
  · intro h
    have harg : ω * τ / 2 = Real.artanh a := by
      rw [← Real.artanh_tanh (ω * τ / 2)]
      rw [h]
    field_simp [hω0]
    linarith
  · intro h
    subst τ
    convert Real.tanh_artanh ha using 1
    field_simp [hω0]

/-- The positive wall is reached at exactly `wallTime ω`; unlike the squared
wall condition, this statement is unique over all real times. -/
theorem peelFlow_eq_wall_iff {ω : ℝ} (hω : 0 < ω) (τ : ℝ) :
    peelFlow ω 0 τ = wall ↔ τ = wallTime ω := by
  exact peelFlow_eq_iff hω wall_mem_Ioo τ

theorem peelFlow_wallTime {ω : ℝ} (hω : 0 < ω) :
    peelFlow ω 0 (wallTime ω) = wall :=
  (peelFlow_eq_wall_iff hω (wallTime ω)).2 rfl

/-- The forward crossing of the squared wall condition is unique: nonnegativity
excludes the simultaneous negative-reflection crossing. -/
theorem eq_wallTime_of_nonneg_of_sq_eq_half {ω τ : ℝ}
    (hω : 0 < ω) (hτ : 0 ≤ τ) (hsq : peelFlow ω 0 τ ^ 2 = (1 / 2 : ℝ)) :
    τ = wallTime ω := by
  apply (peelFlow_eq_wall_iff hω τ).1
  apply (sq_eq_sq₀ (peelFlow_nonneg hω hτ) wall_pos.le).1
  rw [hsq, wall_sq]

/-- There is exactly one forward time at which `Γ² = 1/2`. -/
theorem existsUnique_forward_wall_crossing {ω : ℝ} (hω : 0 < ω) :
    ∃! τ : ℝ, 0 ≤ τ ∧ peelFlow ω 0 τ ^ 2 = (1 / 2 : ℝ) := by
  refine ⟨wallTime ω, ⟨?_, ?_⟩, ?_⟩
  · have ha : 0 < Real.artanh wall := Real.artanh_pos ⟨wall_pos, wall_mem_Ioo.2⟩
    exact (div_pos (mul_pos (by norm_num) ha) hω).le
  · rw [peelFlow_wallTime hω, wall_sq]
  · intro τ hτ
    exact eq_wallTime_of_nonneg_of_sq_eq_half hω hτ.1 hτ.2

/-- At the wall the peel ODE yields the exact rate `ω / 4`. -/
theorem deriv_peelFlow_wallTime {ω : ℝ} (hω : 0 < ω) :
    deriv (peelFlow ω 0) (wallTime ω) = ω / 4 := by
  rw [deriv_peelFlow, peelFlow_wallTime hω, wall_sq]
  ring

/-- The scalar ledger at the crossing has its library value `log 2 / 2`. -/
theorem ledger_at_wallTime {ω : ℝ} (hω : 0 < ω) :
    φled (peelFlow ω 0 (wallTime ω)) = (1 / 2 : ℝ) * Real.log 2 := by
  rw [peelFlow_wallTime hω]
  exact φled_wall


/-- The wall time is strictly positive for positive frequency. -/
theorem wallTime_pos {ω : ℝ} (hω : 0 < ω) : 0 < wallTime ω := by
  have ha : 0 < Real.artanh wall :=
    Real.artanh_pos ⟨wall_pos, wall_mem_Ioo.2⟩
  exact div_pos (mul_pos (by norm_num) ha) hω

/-- Exact inverse-hyperbolic form of the wall: the ratio inside `artanh`
simplifies to the square of `1 + sqrt 2`. -/
theorem artanh_wall :
    Real.artanh wall = Real.log (1 + Real.sqrt 2) := by
  have hs : Real.sqrt (2 : ℝ) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hspos : 0 < Real.sqrt (2 : ℝ) := Real.sqrt_pos.2 (by norm_num)
  have hden : 1 - wall ≠ 0 := ne_of_gt (sub_pos.mpr wall_mem_Ioo.2)
  have hsone : 1 < Real.sqrt (2 : ℝ) := by
    rw [show (1 : ℝ) = Real.sqrt 1 by simp]
    exact Real.sqrt_lt_sqrt (by norm_num) (by norm_num)
  have hsne : Real.sqrt (2 : ℝ) - 1 ≠ 0 := ne_of_gt (sub_pos.mpr hsone)
  have harg : (1 + wall) / (1 - wall) = (1 + Real.sqrt 2) ^ 2 := by
    rw [wall] at hden ⊢
    field_simp [hden, ne_of_gt hspos, hsne]
    nlinarith
  rw [Real.artanh_eq_half_log ⟨wall_mem_Ioo.1.le, wall_mem_Ioo.2.le⟩,
    harg, Real.log_pow]
  norm_num
  ring

/-- The exact zero-to-wall transit time in elementary logarithmic form. -/
theorem wallTime_eq_log (ω : ℝ) :
    wallTime ω = 2 * Real.log (1 + Real.sqrt 2) / ω := by
  rw [wallTime, artanh_wall]

/-- Equivalently, `(2 / ω) * artanh wall = (2 / ω) * log (1 + sqrt 2)`. -/
theorem two_div_omega_mul_artanh_wall (ω : ℝ) :
    (2 / ω) * Real.artanh wall = (2 / ω) * Real.log (1 + Real.sqrt 2) := by
  rw [artanh_wall]

/-- The shorter clock `log (1 + sqrt 2) / ω` is false for every positive
frequency.  The correct time is exactly twice that expression. -/
theorem short_wall_clock_is_false {ω : ℝ} (hω : 0 < ω) :
    (2 / ω) * Real.artanh wall ≠ (1 / ω) * Real.log (1 + Real.sqrt 2) := by
  rw [artanh_wall]
  have hL : 0 < Real.log (1 + Real.sqrt 2) := by
    apply Real.log_pos
    have hs : 0 < Real.sqrt (2 : ℝ) := Real.sqrt_pos.2 (by norm_num)
    linarith
  intro h
  have hω0 : ω ≠ 0 := ne_of_gt hω
  field_simp [hω0] at h
  nlinarith

/-- In particular, the actual clock is strictly later than the proposed
short clock. -/
theorem short_wall_clock_lt_wallTime {ω : ℝ} (hω : 0 < ω) :
    (1 / ω) * Real.log (1 + Real.sqrt 2) < wallTime ω := by
  rw [wallTime_eq_log]
  have hL : 0 < Real.log (1 + Real.sqrt 2) := by
    apply Real.log_pos
    have hs : 0 < Real.sqrt (2 : ℝ) := Real.sqrt_pos.2 (by norm_num)
    linarith
  have hω0 : ω ≠ 0 := ne_of_gt hω
  field_simp [hω0]
  nlinarith


#print axioms hasDerivAt_peelFlow
#print axioms existsUnique_forward_wall_crossing
#print axioms deriv_peelFlow_wallTime
#print axioms wallTime_eq_log
#print axioms short_wall_clock_is_false

end

end ElementalPeeling.LoopWall.WallClock
